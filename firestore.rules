rules_version = '2';

// Roles and studentIds come from Firebase Auth custom claims, set only by
// a Cloud Function (account creation / approval flow). Never trust a role
// field stored on a client-writable document for access control.
service cloud.firestore {
  match /databases/{database}/documents {

    function role() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return request.auth != null && role() == 'admin';
    }

    function isTeacher() {
      return request.auth != null && role() == 'teacher';
    }

    function isParentOf(studentId) {
      return request.auth != null && role() == 'parent'
        && studentId in request.auth.token.studentIds;
    }

    function isSelf(studentId) {
      return request.auth != null && role() == 'student'
        && request.auth.token.studentId == studentId;
    }

    match /users/{uid} {
      allow read: if request.auth != null && (isAdmin() || request.auth.uid == uid);
      allow write: if isAdmin();
      // A signed-in user may only ever clear their own mustChangePassword
      // flag (after actually changing it via Firebase Auth) — nothing else
      // about their own /users doc is client-writable.
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword'])
        && request.resource.data.mustChangePassword == false;
    }

    match /students/{studentId} {
      allow read: if isAdmin() || isTeacher()
        || isParentOf(studentId) || isSelf(studentId);
      allow write: if isAdmin();
    }

    // Created client-side by admin during walk-in registration; approving
    // one (creating the student doc + parent Auth account) always goes
    // through the approveEnrollment Cloud Function, which uses the Admin
    // SDK and so is not itself bound by these rules.
    match /enrollmentRequests/{requestId} {
      allow read, create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /parents/{uid} {
      allow read: if isAdmin() || request.auth.uid == uid;
      allow write: if isAdmin();
    }

    match /teachers/{uid} {
      allow read: if isAdmin() || request.auth.uid == uid;
      allow write: if isAdmin();
    }

    match /schoolYears/{yearId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Students/parents may only ever READ grades — never write, no matter
    // what role claim a forged request might carry.
    match /grades/{gradeId} {
      allow read: if isAdmin()
        || (isTeacher() && resource.data.teacherUid == request.auth.uid)
        || isParentOf(resource.data.studentId)
        || isSelf(resource.data.studentId);
      allow create, update: if isAdmin()
        || (isTeacher() && request.resource.data.teacherUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if isAdmin()
        || (isTeacher() && resource.data.recordedBy == request.auth.uid)
        || isParentOf(resource.data.studentId)
        || isSelf(resource.data.studentId);
      allow create, update: if isAdmin()
        || (isTeacher() && request.resource.data.recordedBy == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /assignments/{assignmentId} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        || (isTeacher() && request.resource.data.teacherUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Payments: parents/students read-only, all writes go through an admin
    // Cloud Function so balances can never be tampered with client-side.
    match /payments/{paymentId} {
      allow read: if isAdmin()
        || isParentOf(resource.data.studentId)
        || isSelf(resource.data.studentId);
      allow write: if isAdmin();
    }

    // recipientUids is resolved client-side (student's parentIds + their own
    // uid, if any) from a class roster the teacher can already read, so it
    // is trustworthy enough to gate read access directly on it.
    match /messages/{messageId} {
      allow read: if request.auth != null &&
        (resource.data.fromUid == request.auth.uid
          || request.auth.uid in resource.data.recipientUids);
      allow create: if request.auth != null
        && (isTeacher() || isAdmin())
        && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if false;
    }

    // A locked-field change (name typo, email, phone, sex, class, role) an
    // account holder cannot make directly — see isSelf()/role() above for
    // why: those fields feed access control or identity, so only an admin
    // (or, for email/role, the applyProfileChangeRequest Cloud Function
    // acting as admin) may actually apply one.
    match /profileChangeRequests/{requestId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read: if request.auth != null && resource.data.toUid == request.auth.uid;
      // A recipient may only flip `seen` on their own notification, nothing else.
      allow update: if request.auth != null && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']);
      // Teachers create absence alerts directly (see createAbsenceNotifications);
      // any other notification type is admin-only.
      allow create: if isAdmin() || (isTeacher() && request.resource.data.type == 'absence');
      allow delete: if isAdmin();
    }
  }
}
